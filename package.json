{
  "name": "kerrtk-media-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:awh": "npm run dev --workspace=apps/aging-with-honor",
    "dev:gij": "npm run dev --workspace=apps/game-integrity-journal",
    "build:awh": "npm run build --workspace=apps/aging-with-honor",
    "build:gij": "npm run build --workspace=apps/game-integrity-journal",
    "build": "npm run build:awh && npm run build:gij",
    "lint:awh": "npm run lint --workspace=apps/aging-with-honor",
    "lint:gij": "npm run lint --workspace=apps/game-integrity-journal"
  }
}
