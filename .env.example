# Brevo — required for the email capture form to work.
# Without these the form tells visitors sign-up is not switched on yet,
# rather than silently discarding their address.
#
# Get the key from Brevo: Settings -> SMTP & API -> API Keys
# Get the list id from Brevo: Contacts -> Lists (the numeric ID column)
#
# Set both in Vercel: Project -> Settings -> Environment Variables.
# Do not commit real values to this file.

BREVO_API_KEY=
BREVO_LIST_ID=
